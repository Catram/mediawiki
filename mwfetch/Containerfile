# mwfetch, published as ghcr.io/catram/mwfetch, for the fetch stage of the
# image's Containerfile and the weekly pins job: the program, with the CA
# certificates it needs to download and patch(1) for patches/. Built by
# .github/workflows/mwfetch.yml whenever this folder changes.

# Pinned by digest, so a build depends only on the commit; Dependabot moves
# the pins when the images are updated.
FROM docker.io/library/golang:1.27-trixie@sha256:c65ecfe613b539ac74c62a4c3b2c27e8f8a6076384c8f27e8a3c0f3be17cc385 AS build
WORKDIR /src
COPY . .
RUN set -eux; \
	go test ./...; \
	CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /mwfetch .

FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends ca-certificates patch; \
	rm -rf /var/lib/apt/lists/*
COPY --from=build /mwfetch /usr/local/bin/mwfetch
